using System;
using System.Globalization;

class Grades
{
    static void Main()
    {
        var inv = CultureInfo.InvariantCulture;

        Console.Write("Enter the number of grades: ");
        int count = int.Parse(Console.ReadLine());

        if (count <= 0)
        {
            Console.WriteLine("Error: the number of grades must be greater than 0");
            return;
        }

        double total = 0;

        for (int i = 1; i <= count; i++)
        {
            Console.Write($"Enter grade {i}: ");
            double grade = double.Parse(Console.ReadLine(), inv);

            // Ask again until the grade is within the 1-6 scale
            while (grade < 1 || grade > 6)
            {
                Console.WriteLine("Invalid grade, it must be between 1 and 6.");
                Console.Write($"Enter grade {i}: ");
                grade = double.Parse(Console.ReadLine(), inv);
            }

            total += grade;
        }

        double average = total / count;
        Console.WriteLine("Average: " + average.ToString("F2", inv));

        if (average >= 3.0)
            Console.WriteLine("The student passed.");
        else
            Console.WriteLine("The student did not pass.");
    }
}
